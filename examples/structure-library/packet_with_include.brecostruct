/*
 * Reusable includes.
 *
 * Loading this file first loads CommonHeader from common_header.brecostruct,
 * after which the included type can be used like a local declaration.
 */

include "common_header.brecostruct";

/default ExamplePacket

struct ExamplePacket {
    /cond(true) CommonHeader header;
    uint16<le> payloadLength;
}
