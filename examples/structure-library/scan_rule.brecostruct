/*
 * Structure-based scanning.
 *
 * Select ScanCandidate and press the Scan button above the structure editor.
 * A result is emitted only where all three conditions succeed.
 */

/default ScanCandidate

struct ScanCandidate {
    /cond(=0x42) uint8 marker;
    /cond(=0x52) uint8 kind;
    /cond(=1) uint8 version;
    uint8 payloadLength;
}
