/default PNG

struct PNGSignature {
  /cond(=0x89) byte marker;
  /cond(="PNG") asciistr<len:3> identifier;
  /cond(="\r\n") asciistr<len:2> dosLineEnding;
  /cond(=0x1A) byte endOfFile;
  /cond(="\n") asciistr<len:1> unixLineEnding;
}

// Signature plus the IHDR chunk. Width and height are pixel dimensions.
struct PNGHeader {
  /cond(true) PNGSignature signature;
  /cond(=13) uint32<be> ihdrLength;
  /cond(="IHDR") asciistr<len:4> ihdrType;
  uint32<be> width;
  uint32<be> height;
  uint8 bitDepth;
  uint8 colorType;
  uint8 compressionMethod;
  uint8 filterMethod;
  uint8 interlaceMethod;
  uint32<be> ihdrCrc;
}

// One PNG chunk: length, 4-byte type, payload, and CRC.
// Use at a known byte offset to inspect tEXt, zTXt, iTXt, IDAT, and other chunks.
struct PNGChunk {
  /var(chunkLength) uint32<be> length;
  asciistr<len:4> type;
  byte<len:$chunkLength> data;
  uint32<be> crc;
}

struct PNGsRGBChunk {
  /cond(=1) uint32<be> length;
  /cond(="sRGB") asciistr<len:4> type;
  uint8 renderingIntent;
  uint32<be> crc;
}

struct PNGgAMAChunk {
  /cond(=4) uint32<be> length;
  /cond(="gAMA") asciistr<len:4> type;
  uint32<be> gammaTimes100000;
  uint32<be> crc;
}

struct PNGpHYsChunk {
  /cond(=9) uint32<be> length;
  /cond(="pHYs") asciistr<len:4> type;
  uint32<be> pixelsPerUnitX;
  uint32<be> pixelsPerUnitY;
  uint8 unit;
  uint32<be> crc;
}

// tEXt payload is keyword, a NUL byte, then the text bytes with no terminator.
struct PNGtEXtChunk {
  /var(chunkLength) uint32<be> length;
  /cond(="tEXt") asciistr<len:4> type;
  byte<len:$chunkLength> data;
  uint32<be> crc;
}

struct PNGtIMEChunk {
  /cond(=7) uint32<be> length;
  /cond(="tIME") asciistr<len:4> type;
  uint16<be> year;
  uint8 month;
  uint8 day;
  uint8 hour;
  uint8 minute;
  uint8 second;
  uint32<be> crc;
}

struct PNGIENDChunk {
  /cond(=0) uint32<be> length;
  /cond(="IEND") asciistr<len:4> type;
  uint32<be> crc;
}

// Best-effort whole-file view. BrecoScript cannot yet repeat PNGChunk until a
// chunk whose type is IEND, so retain the intervening chunks as one raw byte
// span. <until> leaves the sentinel unconsumed, allowing PNGIENDChunk to
// validate and consume it.
//
// Caveat: <until> searches raw bytes rather than PNG chunk boundaries. The
// eight-byte sequence 00 00 00 00 49 45 4E 44 can legally occur inside chunk
// data, in which case this view will stop early. It also retains all chunk
// bytes in one node instead of decoding individual chunks.
struct PNG {
  /cond(true) PNGHeader header;
  byte<until:="\0\0\0\0IEND"> chunks;
  /cond(true) PNGIENDChunk end;
}

// IHDR plus sRGB, gAMA, and pHYs when they immediately follow IHDR.
struct PNGWithColorMetadata {
  PNGHeader header;
  PNGsRGBChunk srgb;
  PNGgAMAChunk gama;
  PNGpHYsChunk phys;
}
