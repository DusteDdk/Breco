/*
 * PE32+ (64-bit) image header for Windows DLLs.
 *
 * Same on-disk layout as executables.  DLL images set the IMAGE_FILE_DLL
 * flag (0x2000) in the COFF Characteristics field.
 *
 * Export and import tables are referenced only through data-directory RVA/size
 * pairs.  Decode those regions in separate views at the corresponding file
 * offsets.
 *
 * Example:
 *   brecodump -s examples/windows_dll.brecostruct -i Qt6Core.dll -e WindowsDll
 *   brecodump -s examples/windows_dll.brecostruct -i Qt6Core.dll -e ImageExportDirectory -ofs 6311936
 */

/default WindowsDll

struct ImageDosHeader {
    /cond(=0x5A4D) uint16<le> e_magic;
    uint16<le> e_cblp;
    uint16<le> e_cp;
    uint16<le> e_crlc;
    uint16<le> e_cparhdr;
    uint16<le> e_minalloc;
    uint16<le> e_maxalloc;
    uint16<le> e_ss;
    uint16<le> e_sp;
    uint16<le> e_csum;
    uint16<le> e_ip;
    uint16<le> e_cs;
    uint16<le> e_lfarlc;
    uint16<le> e_ovno;
    uint16<le><len:4> e_res;
    uint16<le> e_oemid;
    uint16<le> e_oeminfo;
    uint16<le><len:10> e_res2;
    /var(eLfanew) int32<le> e_lfanew;
}

struct ImageFileHeader {
    /cond(=0x8664) uint16<le> Machine;
    /var(numberOfSections) uint16<le> NumberOfSections;
    uint32<le> TimeDateStamp;
    uint32<le> PointerToSymbolTable;
    uint32<le> NumberOfSymbols;
    /var(sizeOfOptionalHeader) uint16<le> SizeOfOptionalHeader;
    /var(characteristics) uint16<le> Characteristics;
}

struct ImageDataDirectory {
    uint32<le> VirtualAddress;
    uint32<le> Size;
}

struct ImageOptionalHeader64 {
    /cond(=0x20B) uint16<le> Magic;
    uint8 MajorLinkerVersion;
    uint8 MinorLinkerVersion;
    uint32<le> SizeOfCode;
    uint32<le> SizeOfInitializedData;
    uint32<le> SizeOfUninitializedData;
    uint32<le> AddressOfEntryPoint;
    uint32<le> BaseOfCode;
    uint64<le> ImageBase;
    uint32<le> SectionAlignment;
    uint32<le> FileAlignment;
    uint16<le> MajorOperatingSystemVersion;
    uint16<le> MinorOperatingSystemVersion;
    uint16<le> MajorImageVersion;
    uint16<le> MinorImageVersion;
    uint16<le> MajorSubsystemVersion;
    uint16<le> MinorSubsystemVersion;
    uint32<le> Win32VersionValue;
    uint32<le> SizeOfImage;
    uint32<le> SizeOfHeaders;
    uint32<le> CheckSum;
    /var(subsystem) uint16<le> Subsystem;
    uint16<le> DllCharacteristics;
    uint64<le> SizeOfStackReserve;
    uint64<le> SizeOfStackCommit;
    uint64<le> SizeOfHeapReserve;
    uint64<le> SizeOfHeapCommit;
    uint32<le> LoaderFlags;
    uint32<le> NumberOfRvaAndSizes;
    /repeat(16) ImageDataDirectory DataDirectory;
}

struct ImageSectionHeader {
    byte<len:8> Name;
    uint32<le> VirtualSize;
    uint32<le> VirtualAddress;
    uint32<le> SizeOfRawData;
    uint32<le> PointerToRawData;
    uint32<le> PointerToRelocations;
    uint32<le> PointerToLinenumbers;
    uint16<le> NumberOfRelocations;
    uint16<le> NumberOfLinenumbers;
    uint32<le> Characteristics;
}

struct ImageExportDirectory {
    uint32<le> Characteristics;
    uint32<le> TimeDateStamp;
    uint16<le> MajorVersion;
    uint16<le> MinorVersion;
    uint32<le> Name;
    uint32<le> Base;
    /var(numberOfFunctions) uint32<le> NumberOfFunctions;
    /var(numberOfNames) uint32<le> NumberOfNames;
    uint32<le> AddressOfFunctions;
    uint32<le> AddressOfNames;
    uint32<le> AddressOfNameOrdinals;
}

struct WindowsDll {
    /cond(true) ImageDosHeader dosHeader;
    byte<len:$dosHeader.eLfanew - 64> dosStub;
    /cond(=0x00004550) uint32<le> signature;
    /cond(true) ImageFileHeader fileHeader;
    /cond(true) ImageOptionalHeader64 optionalHeader;
    /repeat($fileHeader.numberOfSections) ImageSectionHeader sectionHeaders;
}
