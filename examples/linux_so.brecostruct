/*
 * ELF64 header and program-header table for Linux shared objects (.so).
 *
 * Shared objects use the same on-disk layout as PIE executables (ET_DYN).
 * Section headers are not sequential with the program-header table; decode
 * Elf64Shdr instances at byte offset e_shoff (from the ELF header) with repeat
 * count e_shnum.
 *
 * Example:
 *   brecodump -s examples/linux_so.brecostruct -i /lib/x86_64-linux-gnu/libc.so.6 -e LinuxSharedObject
 *   brecodump -s examples/linux_so.brecostruct -i /lib/x86_64-linux-gnu/libc.so.6 -e Elf64Shdr -ofs 2121232 -r 64
 *   brecodump -s examples/linux_so.brecostruct -i /lib/x86_64-linux-gnu/libc.so.6 -e Elf64Note -ofs 848
 */

/default LinuxSharedObject

struct Elf64Ident {
    /cond(=0x7F) byte ei_mag0;
    /cond(=0x45) byte ei_mag1;
    /cond(=0x4C) byte ei_mag2;
    /cond(=0x46) byte ei_mag3;
    /var(eiClass) byte ei_class;
    /var(eiData) byte ei_data;
    byte ei_version;
    byte ei_osabi;
    byte ei_abiversion;
    byte<len:7> ei_pad;
}

struct Elf64Ehdr {
    /cond(true) Elf64Ident ident;
    /cond(=3) /var(eType) uint16<le> e_type;
    uint16<le> e_machine;
    uint32<le> e_version;
    uint64<le> e_entry;
    uint64<le> e_phoff;
    uint64<le> e_shoff;
    uint32<le> e_flags;
    /var(eEhsize) uint16<le> e_ehsize;
    /var(ePhentsize) uint16<le> e_phentsize;
    /var(ePhnum) uint16<le> e_phnum;
    /var(eShentsize) uint16<le> e_shentsize;
    /var(eShnum) uint16<le> e_shnum;
    uint16<le> e_shstrndx;
}

struct Elf64Phdr {
    /var(pType) uint32<le> p_type;
    uint32<le> p_flags;
    uint64<le> p_offset;
    uint64<le> p_vaddr;
    uint64<le> p_paddr;
    /var(pFilesz) uint64<le> p_filesz;
    uint64<le> p_memsz;
    uint64<le> p_align;
}

struct Elf64Shdr {
    uint32<le> sh_name;
    uint32<le> sh_type;
    uint64<le> sh_flags;
    uint64<le> sh_addr;
    uint64<le> sh_offset;
    /var(shSize) uint64<le> sh_size;
    uint32<le> sh_link;
    uint32<le> sh_info;
    uint64<le> sh_addralign;
    uint64<le> sh_entsize;
}

struct Elf64Note {
    /var(nNamesz) uint32<le> n_namesz;
    /var(nDescsz) uint32<le> n_descsz;
    uint32<le> n_type;
    byte<len:$nNamesz> name;
    byte<len:$nDescsz> desc;
}

struct LinuxSharedObject {
    /cond(true) Elf64Ehdr ehdr;
    /repeat($ehdr.ePhnum) Elf64Phdr phdrs;
}
